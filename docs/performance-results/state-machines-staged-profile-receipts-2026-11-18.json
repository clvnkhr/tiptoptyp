  "ownership_contract": {
    "physical_ledger": "The retained connection root and model/global epoch plus its bound WorkspaceSession profile own completed disk heads. Unbound connections retain their current browser-profile identity.",
    "queue_capture": "Mirror work takes the physical owner profile, so old queued work cannot be relabeled as the staged new login.",
    "head_admission": "Reject wrong root, profile, global epoch or model epoch. Advance only exact predecessor-to-written checkpoint progressions; an old receipt cannot roll back a known later head.",
    "installation_admission": "Browser identity gates hydration/tree installation, passive files, top-level browser errors and cursor/open-after navigation. Each mismatched-profile file is independently eligible only when its save entity/operation and submitted global operation/key are exact current owners. Its existing success/failure receipt path may retire/acknowledge the original document; the rest of a mixed batch stays excluded.",
    "preserved_state": [
      "native source key and dirty draft",
      "connection root and saved old workspace profile",
      "strict source/destination and journal CAS checks",
      "existing hydration/source freshness checks"
    ],
    "negative_cases": [
      "unrelated account profile",
      "staged current UI profile that does not own the old workspace",
      "wrong root",
      "wrong epoch",
      "older committed receipt after a later head",
      "stale save operation beside a newer current operation",
      "mixed passive batch errors/navigation while an exact owned save completes"
    ],
    "cost": "Profile lookup and added domain/save-slot comparisons are bounded constant-size identity checks per already-bounded batch member; existing checkpoint map and save completion work is unchanged. No new job, disk IO, polling, idle repaint, automatic retry or per-frame source scan.",
